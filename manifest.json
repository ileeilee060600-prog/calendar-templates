{
  "manifest_version": 3,
  "name": "Calendar Templates",
  "version": "1.8.0",
  "description": "Event templates and a fast day planner for Google Calendar. Press Alt+T, pick a template, done.",
  "minimum_chrome_version": "116",
  "homepage_url": "https://ileeilee060600-prog.github.io/calendar-templates/",
  "key": "",
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://calendar.google.com/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://calendar.google.com/*"
      ],
      "js": [
        "lib.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Plan with templates (Alt+T)",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}